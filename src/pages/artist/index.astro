---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RecordTable from '../../components/RecordTable.astro';
import type { Column, Row } from '../../components/RecordTable.astro';

/* 메뉴가 목차라면 이 페이지는 색인이다.
   같은 여덟 명을 다루지만 열을 더 얹어 역할을 가른다. */
const artists = (await getCollection('artists')).sort(
  (a, b) => a.data.no - b.data.no
);

const columns: Column[] = [
  { key: 'no', label: 'No', isNumber: true },
  { key: 'name', label: 'Artist' },
  { key: 'roles', label: 'Role' },
  { key: 'genres', label: 'Genre', isClassifier: true },
  { key: 'since', label: 'Since', noWrap: true },
  { key: 'base', label: 'Base', noWrap: true },
];

const rows: Row[] = artists.map((artist) => ({
  href: `/artist/${artist.id}`,
  cells: {
    no: String(artist.data.no).padStart(2, '0'),
    name: artist.data.name,
    roles: artist.data.roles.join(', '),
    genres: artist.data.genres.join(', '),
    since: artist.data.since,
    base: artist.data.base,
  },
}));
---

<Base title="Artist">
  <section class="content-block">
    <h1 class="section-label">Artist Index</h1>
    <RecordTable columns={columns} rows={rows} linkKey="name" />
  </section>
</Base>
