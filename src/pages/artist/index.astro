---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IndexTable from '../../components/IndexTable.astro';
import type { Column, Row } from '../../components/IndexTable.astro';

/* 사이드바가 목차라면 이 페이지는 색인이다.
   같은 8명을 다루지만 열을 더 얹어 역할을 가른다. */
const artists = (await getCollection('artists')).sort(
  (a, b) => a.data.no - b.data.no
);

const columns: Column[] = [
  { key: 'no', label: 'No', no: true },
  { key: 'name', label: 'Artist' },
  { key: 'roles', label: 'Role', dim: true },
  { key: 'genres', label: 'Genre', ital: true, dim: true },
  { key: 'since', label: 'Since', nowrap: true, dim: true },
  { key: 'base', label: 'Base', nowrap: true, dim: true },
];

const rows: Row[] = artists.map((artist) => ({
  href: `/artist/${artist.id}`,
  cells: {
    no: String(artist.data.no).padStart(2, '0'),
    name: artist.data.name,
    roles: artist.data.roles.join(', '),
    genres: artist.data.genres.join(', '),
    since: artist.data.since,
    base: artist.data.base,
  },
}));
---

<Base title="Artist">
  <section class="block">
    <span class="label">Artist Index</span>
    <IndexTable columns={columns} rows={rows} linkKey="name" />
  </section>
</Base>
