---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FactList from '../../components/FactList.astro';
import RecordTable from '../../components/RecordTable.astro';
import type { Column, Row } from '../../components/RecordTable.astro';
import { refToSlug, pad } from '../../lib/artists';

export async function getStaticPaths() {
  const artists = await getCollection('artists');
  return artists.map((artist) => ({
    params: { slug: artist.id },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const { Content } = await render(artist);
const data = artist.data;

/* 이 아티스트가 참여한 작업만 추린다. 협업 작업은 함께한 사람도
   같이 보여줘야 누가 참여했는지 알 수 있다. */
const allArtists = await getCollection('artists');
const nameBySlug = new Map(allArtists.map((entry) => [entry.id, entry.data.name]));

const works = (await getCollection('works'))
  .filter((work) =>
    work.data.artists.some((entry) => entry.artist && refToSlug(entry.artist) === artist.id)
  )
  .sort((a, b) => (b.data.year ?? '').localeCompare(a.data.year ?? ''));

const workColumns: Column[] = [
  { key: 'year', label: 'Year', isNumber: true, sortable: true },
  { key: 'title', label: 'Work', sortable: true },
  { key: 'with', label: 'With' },
  { key: 'type', label: 'Type', isClassifier: true, noWrap: true, sortable: true },
];

const workRows: Row[] = works.map((work) => ({
  href: work.data.url || undefined,
  cells: {
    year: work.data.year,
    title: work.data.title,
    with: work.data.artists
      .map((entry) => (entry.artist ? refToSlug(entry.artist) : ''))
      .filter((slug) => slug && slug !== artist.id)
      .map((slug) => ({ text: nameBySlug.get(slug) ?? slug, href: `/artist/${slug}` })),
    type: work.data.type,
  },
}));
---

<Base title={data.name}>
  <!-- 이름도 본문과 같은 크기로 둔다. 위계는 위치와 여백이 만든다 -->
  <header class="content-block">
    <h1>{data.name}</h1>
  </header>

  <div class="artist-head">
    <div class="artist-facts">
      <FactList
        facts={[
          { label: 'No', value: pad(data.no) },
          { label: 'Role', value: data.roles.join(', ') },
          { label: 'Genre', value: data.genres.join(', ') },
          { label: 'Since', value: data.since },
          { label: 'Base', value: data.base },
          ...data.links.map((link) => ({
            label: link.label,
            value: link.url.replace(/^https?:\/\//, ''),
            url: link.url,
          })),
        ]}
      />
    </div>

    <!-- 인물 사진 자리 -->
    <figure class="artist-profile">
      {
        data.profileImage ? (
          <img
            src={data.profileImage}
            alt={data.profileCaption ?? data.name}
            loading="lazy"
          />
        ) : (
          <div class="image-placeholder">
            <span class="section-label">Profile</span>
          </div>
        )
      }
      {data.profileCaption && <figcaption>{data.profileCaption}</figcaption>}
    </figure>
  </div>

  <section class="content-block body-text">
    <Content />
  </section>

  {
    workRows.length > 0 && (
      <section class="content-block">
        <h2 class="section-label">Works</h2>
        <RecordTable columns={workColumns} rows={workRows} linkKey="title" />
      </section>
    )
  }
</Base>

<style>
  .artist-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px;
    gap: var(--gutter);
    align-items: start;
    margin-bottom: calc(var(--gutter) * 2);
  }

  .artist-profile {
    width: 150px;
  }

  @media (max-width: 720px) {
    .artist-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .artist-profile {
      width: 130px;
    }
  }
</style>
