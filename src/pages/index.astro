---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import RecordTable from '../components/RecordTable.astro';
import type { Column, Row } from '../components/RecordTable.astro';

const home = await getEntry('pages', 'home');
const { Content } = home ? await render(home) : { Content: null };

const artists = (await getCollection('artists')).sort(
  (a, b) => a.data.no - b.data.no
);

/* 아티스트들의 작업을 한 흐름에 모아 연도 역순으로 쌓는다.
   아직 작업이 없으면 아티스트 색인으로 대체한다. */
const activityRows: Row[] = artists
  .flatMap((artist) =>
    artist.data.works.map((work) => ({
      href: `/artist/${artist.id}`,
      cells: {
        year: work.year ?? '',
        title: work.title,
        artist: artist.data.name,
        type: work.type ?? '',
      },
    }))
  )
  .sort((a, b) => String(b.cells.year).localeCompare(String(a.cells.year)));

const activityColumns: Column[] = [
  { key: 'year', label: 'Year', isNumber: true },
  { key: 'title', label: 'Item' },
  { key: 'artist', label: 'Artist', noWrap: true },
  { key: 'type', label: 'Type', isClassifier: true, noWrap: true },
];

const artistColumns: Column[] = [
  { key: 'no', label: 'No', isNumber: true },
  { key: 'name', label: 'Artist' },
  { key: 'roles', label: 'Role' },
];

const artistRows: Row[] = artists.map((artist) => ({
  href: `/artist/${artist.id}`,
  cells: {
    no: String(artist.data.no).padStart(2, '0'),
    name: artist.data.name,
    roles: artist.data.roles.join(', '),
  },
}));

const hasActivity = activityRows.length > 0;
---

<Base>
  {home?.data.notice && <p class="site-notice">{home.data.notice}</p>}

  {
    Content && (
      <section class="content-block body-text">
        <Content />
      </section>
    )
  }

  <section class="content-block">
    <h2 class="section-label">{hasActivity ? 'Recent' : 'Index'}</h2>
    <RecordTable
      columns={hasActivity ? activityColumns : artistColumns}
      rows={hasActivity ? activityRows : artistRows}
      linkKey={hasActivity ? 'title' : 'name'}
    />
  </section>

  <!-- 우측 하단에 작게 놓이는 이미지 자리 -->
  <section class="content-block home-image-slot">
    {
      home?.data.image ? (
        <figure class="home-image">
          <img src={home.data.image} alt={home.data.imageCaption ?? ''} loading="lazy" />
          {home.data.imageCaption && <figcaption>{home.data.imageCaption}</figcaption>}
        </figure>
      ) : (
        <div class="home-image image-placeholder image-placeholder--wide">
          <span class="section-label">Image</span>
        </div>
      )
    }
  </section>
</Base>

<style>
  .home-image-slot {
    display: flex;
    justify-content: flex-end;
    margin-top: calc(var(--gutter) * 3);
  }

  .home-image {
    width: 200px;
    max-width: 60%;
  }

  @media (max-width: 720px) {
    .home-image {
      width: 150px;
    }
  }
</style>
