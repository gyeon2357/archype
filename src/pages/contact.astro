---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const contact = await getEntry('contact', 'index');
const { Content } = contact ? await render(contact) : { Content: null };
const hasBody = Boolean(contact?.body?.trim());
---

<Base title="Contact">
  <header class="page-head">
    <h1 class="section-label">Contact</h1>
  </header>

  {
    hasBody && Content && (
      <section class="content-block body-text">
        <Content />
      </section>
    )
  }

</Base>
