---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MetaBlock from '../../components/MetaBlock.astro';
import settings from '../../../content/settings/settings.json';
import { statusLabel, isPast, price, pad } from '../../lib/format';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const data = product.data;

/* 주문은 폼으로만 받는다. 상품별 주문 링크가 없으면
   설정에 등록한 공용 주문 폼으로 보낸다. */
const orderUrl = data.orderUrl || settings.orderFormUrl || '';
const orderable = !isPast(data.status) && orderUrl !== '';
---

<Base title={data.title}>
  <article>
    <h1 class="block">{data.title}</h1>

    <MetaBlock
      items={[
        { label: 'No', value: pad(data.no) },
        { label: 'Artist', value: data.artist },
        { label: 'Price', value: data.price ? `KRW ${price(data.price)}` : '' },
        { label: 'Status', value: statusLabel[data.status] },
        { label: 'Year', value: data.year },
      ]}
    />

    {
      data.images.length > 0 && (
        <section class="block">
          <div class="gallery">
            {data.images.map((image) => (
              <figure>
                <img src={image.src} alt={image.caption ?? data.title} loading="lazy" />
                {image.caption && <figcaption>{image.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <div class="block prose">
      <Content />
    </div>

    {
      data.specs.length > 0 && (
        <section class="block">
          <span class="label">Specification</span>
          <table class="spec">
            <tbody>
              {data.specs.map((spec) => (
                <tr>
                  <th>{spec.label}</th>
                  <td>{spec.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    <section class="block">
      {
        orderable ? (
          <a class="btn" href={orderUrl} target="_blank" rel="noopener noreferrer">
            Order
          </a>
        ) : isPast(data.status) ? (
          <span class="btn sold">{statusLabel[data.status]}</span>
        ) : (
          <span class="btn dim">Order form not set</span>
        )
      }
      <p class="meta" style="margin-top:8px">
        주문 폼에서 주문 정보와 배송지를 받고, 결제는 계좌이체로 진행합니다.
      </p>
    </section>
  </article>
</Base>
