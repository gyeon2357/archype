---
/**
 * 책의 목차. 데스크톱에서는 좌측에 고정되고,
 * 모바일에서는 문서 맨 위 인덱스 블록으로 그냥 흘러간다.
 * 아이콘은 쓰지 않는다. 현재 위치는 밑줄과 좌측 1px 선으로만 알린다.
 */
import { getCollection } from 'astro:content';
import settings from '../../content/settings/settings.json';

const artists = (await getCollection('artists')).sort(
  (a, b) => a.data.no - b.data.no
);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = path === '/';
const isContact = path === '/contact';

function pad(n: number) {
  return String(n).padStart(2, '0');
}
---

<nav class="index-nav" id="index" aria-label="사이트 인덱스">
  <a class="wordmark" href="/">{settings.siteName}</a>

  <ol class="sections">
    <li>
      <a href="/" aria-current={isHome ? 'page' : undefined}>
        <span class="num">01</span><span class="t">Home</span>
      </a>
    </li>

    <li>
      <a href="/artist" aria-current={path === '/artist' ? 'page' : undefined}>
        <span class="num">02</span><span class="t">Artist</span>
      </a>
      <ol class="artists">
        {
          artists.map((artist) => (
            <li>
              <a
                href={`/artist/${artist.id}`}
                aria-current={path === `/artist/${artist.id}` ? 'page' : undefined}
              >
                <span class="num">{pad(artist.data.no)}</span>
                <span class="t">{artist.data.name}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </li>

    <li>
      <a href="/shop" aria-current={path === '/shop' ? 'page' : undefined}>
        <span class="num">03</span><span class="t">Shop</span>
      </a>
    </li>

    <li>
      <a href="/contact" aria-current={isContact ? 'page' : undefined}>
        <span class="num">04</span><span class="t">Contact</span>
      </a>
    </li>
  </ol>

  <div class="foot">
    {
      settings.socials?.map((social) => (
        <a href={social.url} rel="noopener noreferrer" target="_blank">
          {social.label}
        </a>
      ))
    }
    <span class="dim">© {new Date().getFullYear()} {settings.siteName}</span>
  </div>
</nav>

<style>
  .index-nav {
    display: flex;
    flex-direction: column;
    gap: calc(var(--pad) * 1.5);
  }

  .wordmark {
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sections,
  .artists {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .artists {
    margin-top: 2px;
    padding-left: 1.9em;
  }

  .index-nav a {
    display: flex;
    gap: 0.7em;
    align-items: baseline;
    min-height: var(--tap);
    padding: 4px 0 4px 7px;
    margin-left: -8px;
    border-left: 1px solid transparent;
  }

  .index-nav a[aria-current='page'] {
    border-left-color: var(--ink);
    color: var(--ink);
  }

  .index-nav a[aria-current='page'] .t {
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 0.5px;
  }

  .index-nav .num {
    flex: 0 0 auto;
  }

  .foot {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: auto;
    padding-top: var(--pad);
  }

  .foot a {
    min-height: auto;
    padding: 0;
    margin-left: 0;
    border-left: 0;
  }

  @media (max-width: 720px) {
    .index-nav {
      gap: var(--pad);
    }

    .artists {
      padding-left: 1.7em;
    }

    .foot {
      flex-direction: row;
      gap: 1.2em;
      flex-wrap: wrap;
    }
  }
</style>
