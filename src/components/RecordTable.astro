---
/**
 * 사이트의 단 하나의 목록 조판.
 * Home의 활동 기록과 Artist 색인이 같은 표를 쓴다.
 *
 * 열 머리에 sortable을 주면 눌러서 정렬할 수 있고, 셀에는 링크를
 * 하나 또는 여럿 걸 수 있다. 정렬은 아래 작은 스크립트가 맡는다.
 */
export interface Column {
  /** rows의 cells에서 값을 꺼낼 키 */
  key: string;
  /** 표 머리에 쓸 라틴 라벨 */
  label: string;
  /** 번호 열처럼 작은 라틴 글자로 둘 때 */
  isNumber?: boolean;
  /** 열 너비. table-layout: fixed 라서 이 값이 그대로 적용된다 */
  width?: string;
  /** 분류·장르처럼 성격을 표시하는 열 */
  isClassifier?: boolean;
  /** 열 머리를 눌러 정렬할 수 있게 할 때 */
  sortable?: boolean;
}

/** 한 셀 안에 여러 링크를 늘어놓을 때 쓴다 (협업 작업의 참여자 등) */
export interface CellLink {
  text: string;
  href?: string;
}

export type CellValue = string | number | null | undefined | CellLink[];

export interface Row {
  /** 기본 링크. linkKey로 지정한 열에 걸린다 */
  href?: string;
  /** 열마다 다른 링크를 걸 때 — { artist: '/artist/soon' } */
  hrefs?: Record<string, string | undefined>;
  cells: Record<string, CellValue>;
}

interface Props {
  columns: Column[];
  rows: Row[];
  /** 기본 링크를 걸 열의 key. 기본값은 두 번째 열 */
  linkKey?: string;
}

const { columns, rows, linkKey } = Astro.props;
const anchorKey = linkKey ?? columns[1]?.key ?? columns[0]?.key;

function cellClass(column: Column) {
  const names: string[] = [];
  if (column.isNumber) names.push('item-number');
  if (column.isClassifier) names.push('classifier');
  return names.join(' ') || undefined;
}

function cellText(value: CellValue) {
  return value === null || value === undefined || value === '' ? '—' : String(value);
}

function cellHref(row: Row, column: Column) {
  return row.hrefs?.[column.key] ?? (column.key === anchorKey ? row.href : undefined);
}
---

<table class="record-table">
  <thead>
    <tr>
      {
        columns.map((column, index) => (
          <th scope="col" style={column.width ? `width: ${column.width}` : undefined}>
            {column.sortable ? (
              <button type="button" class="sort-button" data-column={index}>
                {column.label}
              </button>
            ) : (
              column.label
            )}
          </th>
        ))
      }
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          {
            columns.map((column) => {
              const value = row.cells[column.key];
              const href = cellHref(row, column);
              return (
                <td class={cellClass(column)}>
                  {Array.isArray(value) ? (
                    value.length === 0 ? (
                      '—'
                    ) : (
                      value.map((item, index) => (
                        <>
                          {index > 0 && ', '}
                          {item.href ? <a href={item.href}>{item.text}</a> : item.text}
                        </>
                      ))
                    )
                  ) : href ? (
                    <a href={href}>{cellText(value)}</a>
                  ) : (
                    cellText(value)
                  )}
                </td>
              );
            })
          }
        </tr>
      ))
    }
  </tbody>
</table>

<script>
  // 열 머리를 누르면 그 열을 기준으로 행을 다시 늘어놓는다.
  // 같은 열을 다시 누르면 방향이 뒤집힌다.
  document.querySelectorAll<HTMLTableElement>('.record-table').forEach((table) => {
    const body = table.querySelector('tbody');
    if (!body) return;

    table.querySelectorAll<HTMLButtonElement>('.sort-button').forEach((button) => {
      button.addEventListener('click', () => {
        const index = Number(button.dataset.column);
        const descending = button.dataset.direction !== 'desc';

        // 다른 열의 표시를 지운다
        table.querySelectorAll<HTMLButtonElement>('.sort-button').forEach((other) => {
          if (other !== button) {
            delete other.dataset.direction;
            other.removeAttribute('aria-sort');
          }
        });

        button.dataset.direction = descending ? 'desc' : 'asc';
        button.setAttribute('aria-sort', descending ? 'descending' : 'ascending');

        const rows = Array.from(body.rows);
        rows.sort((a, b) => {
          const left = a.cells[index]?.textContent?.trim() ?? '';
          const right = b.cells[index]?.textContent?.trim() ?? '';
          const result = left.localeCompare(right, 'ko', { numeric: true });
          return descending ? -result : result;
        });
        rows.forEach((row) => body.appendChild(row));
      });
    });

    // 말줄임표로 잘린 셀을 누르면 전체 내용을 펼친다.
    // 링크를 눌렀을 때는 펼치지 않고 그대로 이동한다.
    body.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target || target.closest('a')) return;

      const cell = target.closest('td');
      if (!cell) return;

      const truncated = cell.scrollWidth > cell.clientWidth;
      if (truncated || cell.classList.contains('is-expanded')) {
        cell.classList.toggle('is-expanded');
      }
    });
  });
</script>
