---
/**
 * 사이트 뼈대.
 *
 * 공지 띠는 격자 밖에서 화면 전체 너비를 쓰고 모든 페이지에 깔린다.
 * 그 아래 데스크톱은 2열 3행 격자다.
 *   1행: 사이트 이름(ARCHYPE)  |  (비움)
 *   2행: 인덱스 메뉴           |  페이지 내용
 *   3행: 푸터                  |  (비움)
 * 남는 높이는 본문이 든 행이 혼자 가져간다. 그래야 내용이 많든 적든
 * 워드마크와 메뉴가 늘 같은 자리에 서고 푸터만 아래에 붙는다.
 */
import SiteIndex from '../components/SiteIndex.astro';
import settings from '../../content/settings/settings.json';
import { SITE_NAME } from '../site';
import '../styles/type.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;
const isHome = (Astro.url.pathname.replace(/\/+$/, '') || '/') === '/';
const socials = settings.socials ?? [];
const copyright =
  settings.copyright || `© ${new Date().getFullYear()} ${SITE_NAME}`;
const notice = settings.notice ?? '';
const noticeUrl = settings.noticeUrl ?? '';
const noticeIsExternal = /^https?:\/\//.test(noticeUrl);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Pretendard-Regular.subset.woff2"
      crossorigin
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? settings.description ?? ''} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
  </head>

  <body>
    {
      notice && (
        <aside class="site-notice" id="site-notice" data-notice={notice}>
          {noticeUrl ? (
            <a
              class="site-notice-text"
              href={noticeUrl}
              target={noticeIsExternal ? '_blank' : undefined}
              rel={noticeIsExternal ? 'noopener noreferrer' : undefined}
            >
              {notice}
            </a>
          ) : (
            <span class="site-notice-text">{notice}</span>
          )}
          <button type="button" class="site-notice-close section-label" id="site-notice-close">
            Close
          </button>
        </aside>
      )
    }

    <script is:inline>
      /* 닫은 공지는 하루 동안 다시 띄우지 않는다.
         공지 문구가 바뀌면 저장값과 달라져 다시 나타난다.
         요소 바로 뒤에서 실행되므로 깜빡임 없이 숨겨진다. */
      (function () {
        var bar = document.getElementById('site-notice');
        if (!bar) return;
        var KEY = 'archype-notice';
        var DAY = 24 * 60 * 60 * 1000;
        var current = bar.getAttribute('data-notice') || '';
        try {
          var saved = JSON.parse(localStorage.getItem(KEY) || 'null');
          if (saved && saved.text === current && Date.now() < saved.until) {
            bar.hidden = true;
          }
        } catch (error) {
          /* 로컬스토리지를 못 쓰면 그냥 띄운다 */
        }
        var close = document.getElementById('site-notice-close');
        if (close) {
          close.addEventListener('click', function () {
            bar.hidden = true;
            try {
              localStorage.setItem(
                KEY,
                JSON.stringify({ text: current, until: Date.now() + DAY })
              );
            } catch (error) {
              /* 저장이 안 되면 이번 방문에만 숨긴다 */
            }
          });
        }
      })();
    </script>

    <main class="site">
      <header class="site-identity">
        <!-- 홈에서만 h1, 나머지는 p. 두 태그의 상자 치수를 같게 맞춰
             어느 페이지에서나 워드마크와 메뉴가 같은 자리에 선다 -->
        {
          isHome ? (
            <h1 class="site-title">
              <a class="site-name" href="/">
                {SITE_NAME}
              </a>
            </h1>
          ) : (
            <p class="site-title">
              <a class="site-name" href="/">
                {SITE_NAME}
              </a>
            </p>
          )
        }
      </header>

      <aside class="site-index" id="index" aria-label="사이트 인덱스">
        <SiteIndex />
      </aside>

      <article class="site-content">
        <slot />
      </article>

      <footer class="site-footer">
        {
          socials.map((social) => (
            <a href={social.url} target="_blank" rel="noopener noreferrer">
              {social.label}
            </a>
          ))
        }
        <small class="site-copyright">{copyright}</small>
        <!-- 모바일에서만 보이는 인덱스 바로가기. 푸터 우측 끝에 붙는다 -->
        <a class="index-shortcut section-label" href="#index">Index</a>
      </footer>
    </main>

    <style>
      .site {
        display: grid;
        grid-template-columns: var(--index-width) minmax(0, 1fr);
        grid-template-rows: auto 1fr auto;
        column-gap: calc(var(--gutter) * 2.5);
        row-gap: var(--identity-gap);
        padding: var(--gutter);
        min-height: 100vh;
        align-items: start;
        align-content: start;
        /* 메뉴를 펼쳤을 때 브라우저가 스크롤을 보정하면서
           화면이 위로 미끄러지는 것을 막는다 */
        overflow-anchor: none;
      }

      .site-identity {
        grid-area: 1 / 1;
      }

      .site-index {
        grid-area: 2 / 1;
      }

      .site-content {
        grid-area: 2 / 2;
        min-width: 0;
        padding-bottom: calc(var(--gutter) * 4);
      }

      .site-footer {
        grid-area: 3 / 1;
        align-self: end;
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      /* h1과 p의 치수를 똑같이 고정한다 */
      .site-title {
        margin: 0;
        max-width: none;
        font-size: var(--text-size);
        font-weight: 400;
        line-height: var(--line-height);
      }

      .site-name {
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .site-copyright {
        font-size: inherit;
      }

      .index-shortcut {
        display: none;
      }

      /* 모바일은 접지 않고 인덱스를 문서 맨 위로 흘려보낸다.
         본문이 든 행만 남는 높이를 가져가므로 워드마크와 메뉴는
         내용 양과 무관하게 제자리에 선다 */
      @media (max-width: 720px) {
        .site {
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: auto auto 1fr auto;
          row-gap: var(--gutter);
        }

        .site-identity {
          grid-area: 1 / 1;
        }

        .site-index {
          grid-area: 2 / 1;
          padding-bottom: var(--gutter);
          border-bottom: 1px solid var(--rule);
        }

        .site-content {
          grid-area: 3 / 1;
        }

        .site-footer {
          grid-area: 4 / 1;
          flex-direction: row;
          align-items: baseline;
          flex-wrap: wrap;
          column-gap: 1.1em;
          padding-top: var(--gutter);
          border-top: 1px solid var(--rule);
        }

        .index-shortcut {
          display: inline-block;
          margin-left: auto;
        }
      }

      @media (min-width: 721px) and (max-width: 980px) {
        .site {
          grid-template-columns: 168px minmax(0, 1fr);
          column-gap: calc(var(--gutter) * 1.6);
        }
      }
    </style>
  </body>
</html>
