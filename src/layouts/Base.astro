---
/**
 * 사이트 뼈대.
 *
 * 공지 띠는 격자 밖에서 화면 전체 너비를 쓴다.
 * 그 아래 데스크톱은 2열 3행 격자다.
 *   1행: 사이트 이름(ARCHYPE)  |  (비움)
 *   2행: 인덱스 메뉴           |  페이지 내용
 *   3행: 푸터                  |  (비움)
 * 본문의 첫 줄이 메뉴 첫 항목과 같은 행에서 시작하므로 둘의 윗선이 맞고,
 * 푸터는 화면 좌측 최하단에 붙는다.
 */
import SiteIndex from '../components/SiteIndex.astro';
import settings from '../../content/settings/settings.json';
import { SITE_NAME } from '../site';
import '../styles/type.css';

interface Props {
  title?: string;
  description?: string;
  /** 화면 맨 위 검은 띠에 올릴 한 줄 */
  notice?: string;
}

const { title, description, notice } = Astro.props;
const fullTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;
const isHome = (Astro.url.pathname.replace(/\/+$/, '') || '/') === '/';
const socials = settings.socials ?? [];
const copyright =
  settings.copyright || `© ${new Date().getFullYear()} ${SITE_NAME}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Pretendard-Regular.subset.woff2"
      crossorigin
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? settings.description ?? ''} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
  </head>

  <body>
    {notice && <aside class="site-notice">{notice}</aside>}

    <main class="site">
      <header class="site-identity">
        {
          isHome ? (
            <h1>
              <a class="site-name" href="/">
                {SITE_NAME}
              </a>
            </h1>
          ) : (
            <a class="site-name" href="/">
              {SITE_NAME}
            </a>
          )
        }
      </header>

      <aside class="site-index" id="index" aria-label="사이트 인덱스">
        <SiteIndex />
      </aside>

      <article class="site-content">
        <slot />
      </article>

      <footer class="site-footer">
        {
          socials.map((social) => (
            <a href={social.url} target="_blank" rel="noopener noreferrer">
              {social.label}
            </a>
          ))
        }
        <small class="site-copyright">{copyright}</small>
        <!-- 모바일에서만 보이는 인덱스 바로가기. 푸터 우측 끝에 붙는다 -->
        <a class="index-shortcut section-label" href="#index">Index</a>
      </footer>
    </main>

    <style>
      .site {
        display: grid;
        grid-template-columns: var(--index-width) minmax(0, 1fr);
        grid-template-rows: auto 1fr auto;
        column-gap: calc(var(--gutter) * 2.5);
        row-gap: var(--identity-gap);
        padding: var(--gutter);
        min-height: 100vh;
        align-items: start;
      }

      .site-identity {
        grid-area: 1 / 1;
      }

      .site-index {
        grid-area: 2 / 1;
      }

      .site-content {
        grid-area: 2 / 2;
        min-width: 0;
        padding-bottom: calc(var(--gutter) * 4);
      }

      .site-footer {
        grid-area: 3 / 1;
        align-self: end;
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .site-name {
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .site-copyright {
        font-size: inherit;
      }

      .index-shortcut {
        display: none;
      }

      /* 모바일은 접지 않고 인덱스를 문서 맨 위로 흘려보낸다.
         푸터는 페이지 맨 아래에 가로로 놓이고, 인덱스 바로가기는
         그 푸터의 우측 끝에 붙는다 */
      @media (max-width: 720px) {
        .site {
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: none;
          row-gap: var(--gutter);
        }

        .site-identity,
        .site-index,
        .site-content,
        .site-footer {
          grid-area: auto;
        }

        .site-index {
          padding-bottom: var(--gutter);
          border-bottom: 1px solid var(--rule);
        }

        .site-footer {
          flex-direction: row;
          align-items: baseline;
          flex-wrap: wrap;
          column-gap: 1.1em;
          padding-top: var(--gutter);
          border-top: 1px solid var(--rule);
        }

        .index-shortcut {
          display: inline-block;
          margin-left: auto;
        }
      }

      @media (min-width: 721px) and (max-width: 980px) {
        .site {
          grid-template-columns: 168px minmax(0, 1fr);
          column-gap: calc(var(--gutter) * 1.6);
        }
      }
    </style>
  </body>
</html>
