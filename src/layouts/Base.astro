---
/**
 * 사이트 뼈대.
 *
 * 데스크톱은 2열 2행 격자다.
 *   1행: 사이트 이름(ARCHYPE)  |  (비움)
 *   2행: 인덱스 메뉴           |  페이지 내용
 * 본문의 첫 줄이 메뉴 첫 항목과 같은 행에서 시작하므로
 * 둘의 윗선이 자동으로 맞는다.
 */
import SiteIndex from '../components/SiteIndex.astro';
import settings from '../../content/settings/settings.json';
import '../styles/type.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} — ${settings.siteName}` : settings.siteName;
const isHome = (Astro.url.pathname.replace(/\/+$/, '') || '/') === '/';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Pretendard-Regular.subset.woff2"
      crossorigin
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? settings.description ?? ''} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
  </head>

  <body>
    <div class="site">
      <header class="site-identity">
        {
          isHome ? (
            <h1 class="site-name">{settings.siteName}</h1>
          ) : (
            <a class="site-name" href="/">
              {settings.siteName}
            </a>
          )
        }
      </header>

      <aside class="site-index" id="index" aria-label="사이트 인덱스">
        <SiteIndex />
      </aside>

      <main class="site-content">
        <slot />
      </main>
    </div>

    <nav class="index-shortcut" aria-label="인덱스로 이동">
      <a class="section-label" href="#index">Index</a>
    </nav>

    <style>
      .site {
        display: grid;
        grid-template-columns: var(--index-width) minmax(0, 1fr);
        column-gap: calc(var(--gutter) * 2.5);
        row-gap: var(--identity-gap);
        padding: var(--gutter);
        align-items: start;
      }

      .site-identity {
        grid-column: 1;
        grid-row: 1;
      }

      .site-index {
        grid-column: 1;
        grid-row: 2;
      }

      .site-content {
        grid-column: 2;
        grid-row: 2;
        min-width: 0;
        padding-bottom: calc(var(--gutter) * 4);
      }

      .site-name {
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .index-shortcut {
        display: none;
      }

      /* 모바일은 접지 않고 인덱스를 문서 맨 위로 흘려보낸다.
         햄버거 아이콘 대신 하단 한 줄에서 인덱스로 되돌아간다 */
      @media (max-width: 720px) {
        .site {
          grid-template-columns: minmax(0, 1fr);
          row-gap: var(--gutter);
          padding-bottom: calc(var(--tap-size) + var(--gutter) * 2);
        }

        .site-identity,
        .site-index,
        .site-content {
          grid-column: 1;
          grid-row: auto;
        }

        .site-index {
          padding-bottom: var(--gutter);
          border-bottom: 1px solid var(--rule);
        }

        .index-shortcut {
          position: fixed;
          inset: auto 0 0 0;
          display: flex;
          justify-content: flex-end;
          align-items: center;
          height: var(--tap-size);
          padding: 0 var(--gutter);
          background: var(--paper);
          border-top: 1px solid var(--rule);
        }
      }

      @media (min-width: 721px) and (max-width: 980px) {
        .site {
          grid-template-columns: 168px minmax(0, 1fr);
          column-gap: calc(var(--gutter) * 1.6);
        }
      }
    </style>
  </body>
</html>
